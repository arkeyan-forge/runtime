# cmake -DINPUT=<shader.metal> -DOUTPUT=<header> -DNAME=<identifier> -P msl_table.cmake
# Reads the argument buffer of descriptor set 0 that MoltenVK's converter wrote (struct spvDescriptorSetBuffer0, one
# member per [[id(n)]]) and writes it as a table: the name, the kind and the id of each member, in id order. Kinds:
# c constant buffer, s sampler, t texture read only, w texture written, b device buffer, a the buffer that emulates a
# texture's atomics (named after the texture, with "_atomic").
file(STRINGS "${INPUT}" lines)
set(inside OFF)
set(entries "")
foreach(line IN LISTS lines)
    if(line MATCHES "^struct spvDescriptorSetBuffer0")
        set(inside ON)
    elseif(inside AND line MATCHES "^};")
        break()
    elseif(inside AND line MATCHES "^[ \t]+(.+)[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]+\\[\\[id\\(([0-9]+)\\)\\]\\];")
        set(type "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")
        set(id "${CMAKE_MATCH_3}")
        if(type MATCHES "atomic_uint" OR type MATCHES "atomic_int")
            set(kind a)
        elseif(type MATCHES "^constant ")
            set(kind c)
        elseif(type MATCHES "^sampler")
            set(kind s)
        elseif(type MATCHES "texture" AND type MATCHES "access::(write|read_write)")
            set(kind w)
        elseif(type MATCHES "texture")
            set(kind t)
        elseif(type MATCHES "device ")
            set(kind b)
        else()
            message(FATAL_ERROR "${INPUT}: unknown argument buffer member: ${line}")
        endif()
        string(APPEND entries "    { \"${name}\", '${kind}', ${id} },\n")
    endif()
endforeach()
if(entries STREQUAL "")
    message(FATAL_ERROR "${INPUT}: no argument buffer for descriptor set 0")
endif()
file(WRITE "${OUTPUT}" "#pragma once\n// Generated by gpu/fsr/msl_table.cmake from ${NAME}'s MSL.\n\ninline constexpr gpu::fsr::MslSlot ${NAME}[] = {\n${entries}};\n")
